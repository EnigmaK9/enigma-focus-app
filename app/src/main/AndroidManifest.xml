<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <!-- Secure settings for system-wide grayscale mode (Daltonizer) -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Foreground service permissions for focus timer -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Query packages to let user select which installed apps to block -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Usage Stats (optional fallback/helper) -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Vibration for haptic feedback when blocked -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Overlay & Pop-up window permission for instant blocking over target apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".FocusApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.EnigmaFocus">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Block Overlay Activity (shown when opening a blocked app) -->
        <activity
            android:name=".ui.block.BlockActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.EnigmaFocus" />

        <!-- Accessibility Service to instantly detect and block apps -->
        <service
            android:name=".service.FocusAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Focus Session Foreground Service -->
        <service
            android:name=".service.FocusForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Focus and productivity session countdown timer" />
        </service>

        <!-- Boot Receiver -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Command Receiver for Unix CLI and Tasker automation -->
        <receiver
            android:name=".receiver.FocusCommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.enigmafocus.action.START_SESSION" />
                <action android:name="com.example.enigmafocus.action.STOP_SESSION" />
                <action android:name="com.example.enigmafocus.action.TOGGLE_GRAYSCALE" />
                <action android:name="com.example.enigmafocus.action.SET_GRAYSCALE" />
                <action android:name="com.example.enigmafocus.action.SET_ALWAYS_BLOCK" />
                <action android:name="com.example.enigmafocus.action.SET_STRICT_MODE" />
                <action android:name="com.example.enigmafocus.action.BLOCK_PACKAGE" />
                <action android:name="com.example.enigmafocus.action.UNBLOCK_PACKAGE" />
                <action android:name="com.example.enigmafocus.action.SET_LANGUAGE" />
                <action android:name="com.example.enigmafocus.action.APPLY_TEMPLATE" />
                <action android:name="com.example.enigmafocus.action.RELOAD_CONFIG" />
                <action android:name="com.example.enigmafocus.action.EXPORT_CONFIG" />
                <action android:name="com.example.enigmafocus.action.GET_STATUS" />
                <action android:name="com.example.enigmafocus.action.CLEAR_LOGS" />
                <action android:name="com.example.enigmafocus.action.DISMISS_SLEEP" />
                <action android:name="com.example.enigmafocus.action.SET_SLEEP_SCHEDULE" />
            </intent-filter>
        </receiver>

        <!-- Quick Settings Tile for Grayscale Mode -->
        <service
            android:name=".service.GrayscaleTileService"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/grayscale_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Quick Settings Tile for Focus Mode -->
        <service
            android:name=".service.FocusTileService"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/focus_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
